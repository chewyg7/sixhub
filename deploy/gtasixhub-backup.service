# Nightly database snapshot (started by gtasixhub-backup.timer).
# Install: see "Backups" in deploy/DEPLOY.md.
[Unit]
Description=GTA 6 Hub database backup

[Service]
Type=oneshot
User=gtasixhub
Group=gtasixhub
WorkingDirectory=/srv/gtasixhub
EnvironmentFile=/etc/gtasixhub.env
ExecStart=/usr/bin/node scripts/backup-db.mjs

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gtasixhub
