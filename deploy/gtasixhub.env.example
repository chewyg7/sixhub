# Copy to /etc/gtasixhub.env (owner root, mode 600) and fill in.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://gtasixhub.com
# Database and uploads; outside the app folder so deploys never touch them.
DATA_DIR=/var/lib/gtasixhub
# Encrypts two-factor secrets. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Keeps admin form actions valid across rebuilds. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Caddy is one proxy hop in front of the app.
TRUSTED_PROXY_HOPS=1
